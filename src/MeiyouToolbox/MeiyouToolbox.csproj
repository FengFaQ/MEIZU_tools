<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- 参考 TKCode.Arc 官方模板：.NET 11 SDK 的优化发布模式会丢弃 Avalonia 编译后的 XAML -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <AssemblyName>MeiyouToolbox</AssemblyName>
        <RootNamespace>MeiyouToolbox</RootNamespace>
        <Version>1.0.0</Version>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- ==== 目录结构：让运行目录保持简洁 ====
             约定（发布后）：
               <程序目录>\
                 MeiyouToolbox.exe
                 lib\        所有依赖 DLL
                 logs\       运行日志（程序内创建）
                 screenshots\内置截图（程序内创建）
                 tools\      adb / fastboot 等外部工具（用户或后续下载）
        -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="TKCode.Arc" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Blocks" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.1.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
            TKCode.Arc.Icons.Lucide 的源生成器只编译"XAML 里以字面量写出的 Kind"。
            需要在运行时动态决定、或通过绑定/数据模板选中的图标必须在此显式声明，
            否则不会打包，运行时不显示（且不报错，只在日志留 warning）。
        -->
        <LucideIcon Include="Activity;FolderOpen;HardDriveDownload;LayoutDashboard;Minus;MonitorCog;PanelLeft;RefreshCw;Settings;Smartphone;Square;Terminal;Wrench;X;Zap" />
    </ItemGroup>
</Project>
