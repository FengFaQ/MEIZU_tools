<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- 参考 TKCode.Arc 官方模板：.NET 11 SDK 的优化发布模式会丢弃 Avalonia 编译后的 XAML -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <AssemblyName>MeiyouToolbox</AssemblyName>
        <RootNamespace>MeiyouToolbox</RootNamespace>
        <Version>1.0.0</Version>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- exe 在资源管理器/任务栏显示的图标。多尺寸（16~256）已内嵌，
             系统会按 DPI 自动挑合适的那一档 -->
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>

        <!-- ==== 目录结构：让运行目录保持简洁 ====
             约定（发布后）：
                <程序目录>\
                  MeiyouToolbox.exe
                  lib\         所有依赖 DLL
                  logs\        运行日志（程序内创建）
                  screenshots\ 内置截图（程序内创建）
                  profiles\    解锁码 / 授权码 / mzkv（程序内创建）
                  backups\     备份产物（程序内创建）
                  Tools\       随包工具链（见下方 Tools 条目）
        -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <!--
            Avalonia 12 把 FluentTheme 拆成了独立包，Avalonia.Desktop 不再传递引用。
            必须有它：TKCode.Arc 的基础主题只覆盖 9 个宿主类型，原生
            ComboBox / CheckBox / ProgressBar / ListBox 没有 ControlTheme，
            不引入任何基础主题时这些控件在界面上完全不渲染（且不报错）。
        -->
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="TKCode.Arc" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Blocks" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.1.0" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.1.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <!--
            payload.bin 解包用的解压器。OTA 里的数据段可能是未压缩(REPLACE)、
            bzip2、xz 或 zstd 四种，SharpCompress 覆盖前三种，ZstdSharp 补 zstd。
            不用 Google.Protobuf：manifest 的 schema 固定，手写变长整数读取
            更轻量，也不会因为 protoc 版本变化而失效（见 Services/PayloadService.cs）。
        -->
        <PackageReference Include="SharpCompress" Version="0.44.0" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
    </ItemGroup>

    <ItemGroup>
        <!--
            TKCode.Arc.Icons.Lucide 的源生成器只编译"XAML 里以字面量写出的 Kind"。
            需要在运行时动态决定、或通过绑定/数据模板选中的图标必须在此显式声明，
            否则不会打包，运行时不显示（且不报错，只在日志留 warning）。
        -->
        <LucideIcon Include="Activity;Archive;ArrowLeftRight;Cable;CircleCheck;CircleDot;CircleX;Cpu;Database;Download;Eraser;FileArchive;FileDown;FileUp;FolderDown;FolderOpen;HardDrive;HardDriveDownload;Import;Info;Key;Layers;LayoutDashboard;ListChecks;Loader;Lock;MemoryStick;Minus;MonitorCog;Package;Paintbrush;PanelLeft;Play;Power;Radio;RefreshCw;RotateCcw;ScanLine;Settings;ShieldAlert;ShieldCheck;Signal;Smartphone;Square;Terminal;Trash2;TriangleAlert;Unlock;Upload;Usb;Wand2;Wrench;X;Zap" />
    </ItemGroup>

    <ItemGroup>
        <!--
            随包工具链（约 105 MB），布局对齐原魅族工具箱：
              Tools\Win\      Windows 端 exe —— adb / fastboot / QSaharaServer / fh_loader /
                              qcedlcmdhelper / gpttool / simg_dump / QCNTool / 7z …
              Tools\Android\  推送到手机的二进制 —— busybox / mke2fs / mkntfs / misc_*.img
              Tools\Other\    杂项
              Tools\res\      各机型的 9008 programmer（res\<product>\devprg）
            这些文件在仓库里（.gitignore 不忽略），构建时原样复制到输出目录；
            CI 打出来的产物即自带工具链，用户解压后无需再单独下载 adb / fastboot。
        -->
        <None Include="Tools\**\*"
              Exclude="Tools\**\*.log;Tools\**\*.tmp"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- 机型表：运行时由 DeviceProfileCatalog 读取，必须随程序打包。
             两种打包方式都要：
               1. AvaloniaResource 把内容嵌进程序集（单文件场景的兜底）
               2. None + CopyToOutputDirectory 让它以真实文件出现在 Assets\ 下
             DeviceProfileCatalog 走的是磁盘读取，只做第 1 条的话运行时找不到文件，
             机型下拉框会是空的（这个坑在 CI 产物里实测踩过）。 -->
        <AvaloniaResource Include="Assets\devices.csv" />
        <None Include="Assets\devices.csv"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
        <!-- 窗口图标：Window.Icon 走 Avalonia 资源系统，和上面的 ApplicationIcon 是两条通路，
             缺一不可（只设 ApplicationIcon 的话窗口左上角仍是空白方块）。
             .ico 给 exe 用，.png 给 Window.Icon 用 —— Avalonia 读 PNG 最稳。 -->
        <AvaloniaResource Include="Assets\app.ico" />
        <AvaloniaResource Include="Assets\app.png" />
    </ItemGroup>
</Project>
