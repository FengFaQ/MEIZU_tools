<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:conv="using:MeiyouToolbox.Converters"
             x:Class="MeiyouToolbox.App"
             RequestedThemeVariant="Light">
    <!--
        基础控件主题：必须有。
        TKCode.Arc 只为自己提供的控件（Card / Button / Input / Select …）注册 ControlTheme，
        它的基础主题 ArcBaseTheme.StyledTypes 只包含
          ScrollViewer / ScrollBar / ItemsControl / PathIcon / TextSelectionHandle /
          OverlayPopupHost / PopupRoot / EmbeddableControlRoot / Window
        这 9 个宿主类型。原生 TextBox / ComboBox / CheckBox / ListBox / ProgressBar
        都不在其中 —— 不引入任何基础主题时，这些控件没有模板，在界面上完全不显示
        （不报错，只是空着）。这里引入 FluentTheme 补上；
        Arc 的基础主题检测到已有主题后会自动让位，不会和它抢那 9 个类型。
    -->
    <Application.Styles>
        <FluentTheme />

        <!--
            全局把 Arc 按钮降到 Small 档（高 36px，默认 Medium 是 44px）。
            原因：刷机页三列并排后，Medium 档按钮太宽，镜像刷写卡与扩展功能卡的按钮
            会互相挤压甚至溢出卡片边界。Small 档在同样的列宽里能放下更多按钮，
            且与卡片内 TypeXS 的说明文字比例更协调。
            个别需要强调的地方仍可单独写 Size="Medium" 覆盖。
        -->
        <Style Selector="arc|Button">
            <Setter Property="Size" Value="Small" />
        </Style>
    </Application.Styles>

    <!--
        只注册本程序自己的转换器。
        颜色/主题一律由 TKCode.Arc 在运行时注册的 Design Token 提供
        （{arc:ArcDesignTokenResource Foreground} 等），不自己拍一套画刷，
        否则会和 Arc 的亮/暗令牌打架，出现"白字白底"。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <conv:StatusDotConverter x:Key="StatusDotConverter" />
            <conv:NavVariantConverter x:Key="NavVariantConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
