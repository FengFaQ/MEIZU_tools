<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:MeiyouToolbox.Converters"
             x:Class="MeiyouToolbox.App"
             RequestedThemeVariant="Light">
    <!--
        只注册本程序自己的转换器。
        颜色/主题一律由 TKCode.Arc 在运行时注册的 Design Token 提供
        （{arc:ArcDesignTokenResource Foreground} 等），不自己拍一套画刷，
        否则会和 Arc 的亮/暗令牌打架，出现"白字白底"。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <conv:StatusDotConverter x:Key="StatusDotConverter" />
            <conv:NavVariantConverter x:Key="NavVariantConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
