<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MeiyouToolbox.Views"
        xmlns:vm="using:MeiyouToolbox.ViewModels"
        x:Class="MeiyouToolbox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="魅友工具箱"
        Width="1180"
        Height="740"
        MinWidth="960"
        MinHeight="600"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <!-- 顶栏、侧栏与自定义窗口按钮都在 MainView 里绘制，
         因此这里用普通 Window（无系统边框样式），标题栏由我们自己实现。 -->
    <views:MainView />
</Window>
