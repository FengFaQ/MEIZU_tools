<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MeiyouToolbox.Views"
        xmlns:vm="using:MeiyouToolbox.ViewModels"
        x:Class="MeiyouToolbox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="魅友工具箱"
        Width="1180"
        Height="740"
        MinWidth="960"
        MinHeight="600"
        Background="White"
        Icon="/Assets/app.png"
        WindowStartupLocation="CenterScreen">
    <!-- 用系统原生标题栏（带最小化 / 最大化 / 关闭），界面内不再自绘顶栏。 -->
    <views:MainView />
</Window>
