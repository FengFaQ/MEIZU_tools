<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">

            <TextBlock Text="设置"
                       FontSize="{arc:ArcDesignTokenResource TypeXL}"
                       FontWeight="SemiBold"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />

            <arc:Card Title="目录" Description="程序的运行目录结构一览。">
                <StackPanel Spacing="12" Margin="0,8,0,0">

                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="程序目录"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppDirectory}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="工具目录"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ToolsDirectory}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="日志目录"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogDirectory}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="截图目录"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScreenshotDirectory}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Button Variant="Secondary" Command="{Binding OpenLogDirectoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Activity" Size="14" />
                                <TextBlock Text="打开日志" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button Variant="Secondary" Command="{Binding OpenScreenshotDirectoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                                <TextBlock Text="打开截图" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button Variant="Secondary" Command="{Binding OpenAppDirectoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="PanelLeft" Size="14" />
                                <TextBlock Text="打开程序目录" />
                            </StackPanel>
                        </arc:Button>
                    </StackPanel>
                </StackPanel>
            </arc:Card>

            <arc:Card Title="行为" Description="启动与导航相关的偏好。">
                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <CheckBox Content="启动时自动探测设备"
                              IsChecked="{Binding AutoProbeOnStartup}"
                              Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </StackPanel>
            </arc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
