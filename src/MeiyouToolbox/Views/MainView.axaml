<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:views="using:MeiyouToolbox.Views"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 侧栏导航：用 Arc 的 Button(Text/Ghost 变体) 承载，颜色走令牌 -->
        <Style Selector="arc|Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="6,2" />
        </Style>
    </UserControl.Styles>

    <DockPanel ClipToBounds="True">

        <!-- ============ 顶栏 ============ -->
        <Border DockPanel.Dock="Top"
                Height="44"
                Padding="6,0"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderThickness="0,0,0,1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- 侧栏展开 / 收起 -->
                <arc:Button Grid.Column="0" Variant="Text"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="显示 / 隐藏侧栏">
                    <lucide:LucideIcon Kind="PanelLeft" Size="16" />
                </arc:Button>

                <!-- 文件 / 更新 / 截图 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            Margin="6,0,0,0" VerticalAlignment="Center">
                    <arc:Button Variant="Text" Content="文件" />
                    <arc:Button Variant="Text" Content="更新" />
                    <arc:Button Variant="Text" Content="截图"
                                Command="{Binding CaptureScreenshotCommand}"
                                ToolTip.Tip="把当前窗口截图保存到 screenshots 目录" />
                </StackPanel>

                <!-- 中间留空 -->
                <Border Grid.Column="2" Background="Transparent" />

                <!-- 最小化 / 最大化 / 关闭 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                    <arc:Button Variant="Text" Click="OnMinimize" ToolTip.Tip="最小化">
                        <lucide:LucideIcon Kind="Minus" Size="14" />
                    </arc:Button>
                    <arc:Button Variant="Text" Click="OnToggleMaximize" ToolTip.Tip="最大化 / 还原">
                        <lucide:LucideIcon Kind="Square" Size="11" />
                    </arc:Button>
                    <arc:Button Variant="Text" Click="OnClose" ToolTip.Tip="关闭">
                        <lucide:LucideIcon Kind="X" Size="14" />
                    </arc:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 侧栏 ============ -->
        <Border DockPanel.Dock="Left"
                Width="192"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderThickness="0,0,1,0"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                IsVisible="{Binding IsSidebarExpanded}">
            <DockPanel LastChildFill="True">

                <!-- 上方 4 项 -->
                <StackPanel DockPanel.Dock="Top" Margin="4,10,4,0" Spacing="2">
                    <arc:Button Classes="nav"
                                Variant="{Binding IsOverview, Converter={StaticResource NavVariantConverter}}"
                                Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <lucide:LucideIcon Kind="LayoutDashboard" Size="16" />
                            <TextBlock Text="概览" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="nav"
                                Variant="{Binding IsFlash, Converter={StaticResource NavVariantConverter}}"
                                Command="{Binding NavigateCommand}" CommandParameter="Flash">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <lucide:LucideIcon Kind="Zap" Size="16" />
                            <TextBlock Text="刷机" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="nav"
                                Variant="{Binding IsBackup, Converter={StaticResource NavVariantConverter}}"
                                Command="{Binding NavigateCommand}" CommandParameter="Backup">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <lucide:LucideIcon Kind="HardDriveDownload" Size="16" />
                            <TextBlock Text="备份" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="nav"
                                Variant="{Binding IsManage, Converter={StaticResource NavVariantConverter}}"
                                Command="{Binding NavigateCommand}" CommandParameter="Manage">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <lucide:LucideIcon Kind="Wrench" Size="16" />
                            <TextBlock Text="管理" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>

                <!-- 设置固定在最下方 -->
                <arc:Button DockPanel.Dock="Bottom" Classes="nav"
                            Margin="4,0,4,10"
                            Variant="{Binding IsSettings, Converter={StaticResource NavVariantConverter}}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <lucide:LucideIcon Kind="Settings" Size="16" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>

                <!-- 中间留白 -->
                <Border />
            </DockPanel>
        </Border>

        <!-- ============ 主窗口：页面宿主 ============ -->
        <Grid>
            <Border IsVisible="{Binding IsOverview}">
                <views:OverviewView DataContext="{Binding Overview}" />
            </Border>

            <Border IsVisible="{Binding IsFlash}">
                <views:FlashView DataContext="{Binding Flash}" />
            </Border>

            <Border IsVisible="{Binding IsBackup}">
                <views:BackupView DataContext="{Binding Backup}" />
            </Border>

            <Border IsVisible="{Binding IsManage}">
                <views:PlaceholderView>
                    <views:PlaceholderView.DataContext>
                        <vm:PlaceholderViewModel Title="管理"
                                                 Description="分区表读写、槽位管理、工具箱目录与日志查看。"
                                                 IconKind="Wrench" />
                    </views:PlaceholderView.DataContext>
                </views:PlaceholderView>
            </Border>

            <Border IsVisible="{Binding IsSettings}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
