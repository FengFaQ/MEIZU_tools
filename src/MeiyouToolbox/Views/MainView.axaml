<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:views="using:MeiyouToolbox.Views"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 侧栏导航：按钮本身始终是"被选中"外观（Secondary 变体常亮），
             当前页靠左侧的强调色竖条区分。 -->
        <Style Selector="arc|Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="6,3" />
        </Style>
        <Style Selector="Border.navmark">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.navmark.on">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </UserControl.Styles>

    <DockPanel ClipToBounds="True">

        <!-- ============ 侧栏 ============ -->
        <Border DockPanel.Dock="Left"
                Width="192"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderThickness="0,0,1,0"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                IsVisible="{Binding IsSidebarExpanded}">
            <DockPanel LastChildFill="True">

                <!-- 上方 4 项 -->
                <StackPanel DockPanel.Dock="Top" Margin="4,12,4,0" Spacing="2">
                    <arc:Button Classes="nav" Variant="Secondary"
                                Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <DockPanel>
                            <Border Classes="navmark" Classes.on="{Binding IsOverview}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                                <lucide:LucideIcon Kind="LayoutDashboard" Size="16" />
                                <TextBlock Text="概览" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </arc:Button>

                    <arc:Button Classes="nav" Variant="Secondary"
                                Command="{Binding NavigateCommand}" CommandParameter="Flash">
                        <DockPanel>
                            <Border Classes="navmark" Classes.on="{Binding IsFlash}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                                <lucide:LucideIcon Kind="Zap" Size="16" />
                                <TextBlock Text="刷机" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </arc:Button>

                    <arc:Button Classes="nav" Variant="Secondary"
                                Command="{Binding NavigateCommand}" CommandParameter="Backup">
                        <DockPanel>
                            <Border Classes="navmark" Classes.on="{Binding IsBackup}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                                <lucide:LucideIcon Kind="HardDriveDownload" Size="16" />
                                <TextBlock Text="备份" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </arc:Button>

                    <arc:Button Classes="nav" Variant="Secondary"
                                Command="{Binding NavigateCommand}" CommandParameter="Manage">
                        <DockPanel>
                            <Border Classes="navmark" Classes.on="{Binding IsManage}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                                <lucide:LucideIcon Kind="Wrench" Size="16" />
                                <TextBlock Text="管理" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </arc:Button>
                </StackPanel>

                <!-- 设置固定在最下方 -->
                <arc:Button DockPanel.Dock="Bottom" Classes="nav"
                            Margin="4,0,4,12"
                            Variant="Secondary"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings">
                    <DockPanel>
                        <Border Classes="navmark" Classes.on="{Binding IsSettings}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                            <lucide:LucideIcon Kind="Settings" Size="16" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </arc:Button>

                <!-- 中间留白 -->
                <Border />
            </DockPanel>
        </Border>

        <!-- ============ 主窗口：页面宿主 ============ -->
        <Grid>
            <Border IsVisible="{Binding IsOverview}">
                <views:OverviewView DataContext="{Binding Overview}" />
            </Border>

            <Border IsVisible="{Binding IsFlash}">
                <views:FlashView DataContext="{Binding Flash}" />
            </Border>

            <Border IsVisible="{Binding IsBackup}">
                <views:BackupView DataContext="{Binding Backup}" />
            </Border>

            <Border IsVisible="{Binding IsManage}">
                <views:ManageView DataContext="{Binding Manage}" />
            </Border>

            <Border IsVisible="{Binding IsSettings}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Border>

            <!-- 「完成任务提示」：全窗口共用的收尾遮罩，任何页面都能触发 -->
            <views:TaskCompleteOverlay DataContext="{Binding TaskComplete}" />

            <!-- 9008 刷写页：从刷机页的「选择刷写通路」打开，全窗口遮罩 -->
            <views:EdlFlashOverlay DataContext="{Binding Edl}" />

            <!-- Fastboot 刷写页：同样从「选择刷写通路」打开 -->
            <views:FastbootFlashOverlay DataContext="{Binding Fastboot}" />

            <!-- 解锁资料子窗口：从刷机页的「导入资料」打开 -->
            <views:CredentialEditorOverlay DataContext="{Binding Flash}" />
        </Grid>
    </DockPanel>
</UserControl>
