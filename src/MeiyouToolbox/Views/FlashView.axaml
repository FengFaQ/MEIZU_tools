<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:models="using:MeiyouToolbox.Models"
             xmlns:sys="using:System"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.FlashView"
             x:DataType="vm:FlashViewModel">

    <Grid>
        <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="10">

            <!-- 标题 + 状态 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="刷机"
                               FontSize="{arc:ArcDesignTokenResource TypeXL}"
                               FontWeight="SemiBold"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <TextBlock Text="{Binding ToolStatus}"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Border Padding="9,4" CornerRadius="6"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Usb" Size="13" />
                            <TextBlock Text="{Binding ConnectionText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        </StackPanel>
                    </Border>
                    <arc:Button Variant="Secondary" Command="{Binding RefreshConnectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:LucideIcon Kind="RefreshCw" Size="13" />
                            <TextBlock Text="刷新" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </Grid>

            <!-- 三列主体：一屏内完整显示 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">

                <!-- 第一列：机型 / 解锁与上锁 / 解锁资料 -->
                <ScrollViewer Grid.Column="0">
                    <StackPanel Spacing="10">

                        <arc:Card Title="机型">
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="选择机型">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DeviceProfile">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding SelectedProfileDetail}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </arc:Card>

                        <arc:Card Title="解锁与上锁">
                            <StackPanel Spacing="8" Margin="0,4,0,0">

                                <TextBlock Text="{Binding SelectedProfile.DisplayName, FallbackValue='未选择机型'}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="Medium"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding UnlockRequiresModeText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <arc:Button Grid.Column="0"
                                                Variant="Primary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding UnlockCommand}"
                                                ToolTip.Tip="自动把手机切到所需状态，然后按原工具箱的流程解锁">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <lucide:LucideIcon Kind="Unlock" Size="14" />
                                            <TextBlock Text="解锁" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                                        </StackPanel>
                                    </arc:Button>

                                    <arc:Button Grid.Column="1"
                                                Variant="Danger"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding LockCommand}"
                                                ToolTip.Tip="自动进入 Fastboot，先写 misc 再上锁">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <lucide:LucideIcon Kind="Lock" Size="14" />
                                            <TextBlock Text="上锁" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                                        </StackPanel>
                                    </arc:Button>
                                </Grid>
                            </StackPanel>
                        </arc:Card>

                        <arc:Card Title="解锁资料">
                            <StackPanel Spacing="6" Margin="0,4,0,0">

                                <TextBlock Text="{Binding ImportCodesHint}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Input IsLabelVisible="False" Grid.Column="0"
                                               Placeholder="粘贴 512 字符解锁码"
                                               Text="{Binding UnlockCodeInput}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Command="{Binding SaveUnlockCodeCommand}">
                                        <TextBlock Text="导入" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </arc:Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Input IsLabelVisible="False" Grid.Column="0"
                                               Placeholder="粘贴 512 字符授权码"
                                               Text="{Binding AuthCodeInput}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Command="{Binding SaveAuthCodeCommand}">
                                        <TextBlock Text="导入" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </arc:Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                    <TextBlock Grid.Column="0" Text="{Binding CredentialStatus}"
                                               VerticalAlignment="Center"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Click="OnPickMzkv"
                                                ToolTip.Tip="选择解锁用 mzkv 镜像">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Kind="Import" Size="12" />
                                            <TextBlock Text="mzkv" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                        </StackPanel>
                                    </arc:Button>
                                    <arc:Button Grid.Column="2" Variant="Ghost"
                                                Command="{Binding ClearCredentialsCommand}">
                                        <TextBlock Text="清空" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </arc:Button>
                                </Grid>
                            </StackPanel>
                        </arc:Card>

                    </StackPanel>
                </ScrollViewer>

                <!-- 第二列：镜像刷写 / 其它写入 -->
                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="10">

                        <!-- 镜像刷写 -->
                        <arc:Card>
                            <StackPanel Spacing="7">

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="镜像刷写"
                                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                        <TextBlock Text="支持 9008 / Fastboot / ADB 刷写"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </StackPanel>

                                    <!-- 通路选择：点开一个小窗口，只有 9008 刷写 / Fastboot 刷写 两个按钮 -->
                                    <arc:Button Grid.Column="1" Variant="Ghost"
                                                Command="{Binding ToggleTargetPickerCommand}"
                                                ToolTip.Tip="选择刷写通路">
                                        <lucide:LucideIcon Kind="PanelLeft" Size="15" />
                                    </arc:Button>
                                </Grid>

                                <!-- 救砖包位置：唯一的路径输入框 -->
                                <TextBlock Text="救砖包位置"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Input IsLabelVisible="False" Grid.Column="0"
                                               Placeholder="线刷包目录，或单个 .img"
                                               Text="{Binding PackagePath}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Click="OnPickPackagePath">
                                        <lucide:LucideIcon Kind="FolderOpen" Size="13" />
                                    </arc:Button>
                                </Grid>

                                <TextBlock Text="{Binding PackageKindText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                    <TextBlock Grid.Column="0" Text="分区名"
                                               VerticalAlignment="Center"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <arc:Input IsLabelVisible="False" Grid.Column="1"
                                               Placeholder="留空按文件名推断"
                                               Text="{Binding PartitionName}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <Border Grid.Column="2" Padding="7,3" CornerRadius="5"
                                            VerticalAlignment="Center"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <TextBlock Text="{Binding FlashTargetText}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </Border>
                                </Grid>

                                <arc:Button Variant="Primary"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding FlashPackageCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="Upload" Size="14" />
                                        <TextBlock Text="刷入" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                                    </StackPanel>
                                </arc:Button>
                            </StackPanel>
                        </arc:Card>

                        <!-- 其它写入 -->
                        <arc:Card Title="其它写入">
                            <StackPanel Spacing="6" Margin="0,4,0,0">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Input IsLabelVisible="False" Grid.Column="0"
                                               Placeholder="Recovery 镜像（.img）"
                                               Text="{Binding RecoveryImagePath}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Click="OnPickRecoveryImage">
                                        <lucide:LucideIcon Kind="FolderOpen" Size="13" />
                                    </arc:Button>
                                </Grid>

                                <arc:Button Variant="Secondary"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding FlashRecoveryCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="HardDriveDownload" Size="13" />
                                        <TextBlock Text="刷入 Recovery" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </StackPanel>
                                </arc:Button>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Input IsLabelVisible="False" Grid.Column="0"
                                               Placeholder="任意分区镜像（.img）"
                                               Text="{Binding PartitionImagePath}"
                                               Height="30"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Click="OnPickPartitionImage">
                                        <lucide:LucideIcon Kind="FolderOpen" Size="13" />
                                    </arc:Button>
                                </Grid>

                                <arc:Button Variant="Secondary"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding FlashPartitionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="Wrench" Size="13" />
                                        <TextBlock Text="刷入指定分区" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </StackPanel>
                                </arc:Button>
                            </StackPanel>
                        </arc:Card>

                    </StackPanel>
                </ScrollViewer>

                <!-- 第三列：扩展功能 / 当前任务 -->
                <ScrollViewer Grid.Column="2">
                    <StackPanel Spacing="10">

                        <!-- 扩展功能（有意不含"bug 反馈"） -->
                        <arc:Card Title="扩展功能">
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <arc:Input IsLabelVisible="False"
                                           Placeholder="9008 引导文件（留空按机型自动选择）"
                                           Text="{Binding ProgrammerPath}"
                                           Height="30"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <arc:Button Grid.Column="0" Variant="Secondary"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding SendFirehoseCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <lucide:LucideIcon Kind="FileUp" Size="13" />
                                            <TextBlock Text="发送 9008 引导" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                        </StackPanel>
                                    </arc:Button>
                                    <arc:Button Grid.Column="1" Variant="Secondary"
                                                Click="OnPickProgrammer"
                                                ToolTip.Tip="选择引导文件">
                                        <lucide:LucideIcon Kind="FolderOpen" Size="13" />
                                    </arc:Button>
                                </Grid>
                            </StackPanel>
                        </arc:Card>

                        <!-- 当前任务 -->
                        <arc:Card Title="当前任务">
                            <StackPanel Spacing="6" Margin="0,4,0,0">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding TaskTitle}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               FontWeight="Medium"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               TextTrimming="CharacterEllipsis" />
                                    <arc:Button Grid.Column="1" Variant="Ghost"
                                                Command="{Binding CancelCommand}"
                                                IsVisible="{Binding IsBusy}">
                                        <TextBlock Text="取消" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </arc:Button>
                                </Grid>

                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding TaskPercent}"
                                             IsIndeterminate="{Binding TaskIndeterminate}"
                                             Height="4" />

                                <TextBlock Text="{Binding TaskMessage}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <Border MaxHeight="380"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="6"
                                        Padding="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               FontFamily="Consolas,monospace"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </arc:Card>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ 通路选择子窗口（窗口内自渲染） ============ -->
        <Grid IsVisible="{Binding IsTargetPickerOpen}" Background="#66000000">
            <Border Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="24"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderThickness="1"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BoxShadow="0 8 32 0 #33000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="选择刷写通路"
                               FontSize="{arc:ArcDesignTokenResource TypeLG}"
                               FontWeight="SemiBold"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />

                    <arc:Button Variant="Primary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="edl">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="Cable" Size="16" />
                            <TextBlock Text="9008 刷写" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Variant="Secondary"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="fastboot">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="Zap" Size="16" />
                            <TextBlock Text="Fastboot 刷写" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Variant="Text" HorizontalAlignment="Center"
                                Command="{Binding CloseTargetPickerCommand}">
                        <TextBlock Text="取消"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </arc:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
