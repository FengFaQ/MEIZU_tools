<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:models="using:MeiyouToolbox.Models"
             xmlns:sys="using:System"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.FlashView"
             x:DataType="vm:FlashViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">

            <!-- ============ 标题 + 连接状态 ============ -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="刷机"
                               FontSize="{arc:ArcDesignTokenResource TypeXL}"
                               FontWeight="SemiBold"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <TextBlock Text="{Binding ToolStatus}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Border Padding="10,5" CornerRadius="6"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Usb" Size="14" />
                            <TextBlock Text="{Binding ConnectionText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        </StackPanel>
                    </Border>
                    <arc:Button Variant="Secondary" Command="{Binding RefreshConnectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </Grid>

            <!-- ============ 机型 ============ -->
            <arc:Card Title="机型"
                      Description="机型决定解锁方案、分区布局与引导分区，刷机前必须选对。探测到设备时会自动匹配。">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="选择机型">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceProfile">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding SelectedProfileDetail}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </arc:Card>

            <!-- ============ 解锁资料 ============ -->
            <arc:Card Title="解锁资料"
                      Description="解锁码与授权码都是 512 个字符；解锁 mzkv 是分区镜像。资料按机型分别保存。">
                <StackPanel Spacing="12" Margin="0,8,0,0">

                    <TextBlock Text="{Binding ImportCodesHint}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextWrapping="Wrap" />

                    <Border Padding="10,8" CornerRadius="6"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <TextBlock Text="{Binding CredentialStatus}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    </Border>

                    <!-- 解锁码 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="解锁码"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding UnlockCodeInput}"
                                     Watermark="粘贴 512 个字符的解锁码"
                                     AcceptsReturn="False"
                                     Height="34" />
                            <arc:Button Grid.Column="1" Variant="Secondary"
                                        Command="{Binding SaveUnlockCodeCommand}">
                                <TextBlock Text="导入" />
                            </arc:Button>
                        </Grid>
                    </StackPanel>

                    <!-- 授权码 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="授权码"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding AuthCodeInput}"
                                     Watermark="粘贴 512 个字符的授权码（Firehose 签名用）"
                                     AcceptsReturn="False"
                                     Height="34" />
                            <arc:Button Grid.Column="1" Variant="Secondary"
                                        Command="{Binding SaveAuthCodeCommand}">
                                <TextBlock Text="导入" />
                            </arc:Button>
                        </Grid>
                    </StackPanel>

                    <!-- mzkv -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="解锁 mzkv 镜像"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <arc:Button Variant="Secondary" Click="OnPickMzkv">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                                    <TextBlock Text="选择镜像" />
                                </StackPanel>
                            </arc:Button>
                            <arc:Button Variant="Text" Command="{Binding ClearCredentialsCommand}">
                                <TextBlock Text="清空该机型资料" />
                            </arc:Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </arc:Card>

            <!-- ============ 解锁 / 上锁 ============ -->
            <arc:Card Title="Bootloader"
                      Description="解锁会清空数据。上锁前必须恢复原厂系统，否则设备可能无法开机。">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Button Variant="Primary" Command="{Binding UnlockCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Unlock" Size="14" />
                                <TextBlock Text="解锁 BL" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button Variant="Danger" Command="{Binding LockCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Lock" Size="14" />
                                <TextBlock Text="上锁 BL" />
                            </StackPanel>
                        </arc:Button>
                    </StackPanel>
                    <TextBlock Text="解锁方案由机型自动决定：有授权码走 9008 写标记，否则走 Fastboot 分段下发解锁码；ODM 机型免码。"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </arc:Card>

            <!-- ============ Recovery ============ -->
            <arc:Card Title="刷入 Recovery"
                      Description="A/B 分区设备（魅族 17 起）没有独立 recovery 分区，本项只适用于单槽机型。">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding RecoveryImagePath}"
                                 Watermark="Recovery 镜像路径（recovery.img）"
                                 Height="34" />
                        <arc:Button Grid.Column="1" Variant="Secondary" Click="OnPickRecoveryImage">
                            <TextBlock Text="浏览" />
                        </arc:Button>
                    </Grid>
                    <arc:Button Variant="Primary" HorizontalAlignment="Left"
                                Command="{Binding FlashRecoveryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Upload" Size="14" />
                            <TextBlock Text="刷入 Recovery" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </arc:Card>

            <!-- ============ 任意分区 ============ -->
            <arc:Card Title="刷入任意分区"
                      Description="当前连接方式自动决定传输通路：系统/Recovery 用 dd，Fastboot 用 flash，9008 用 rawprogram。">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="180,*" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding PartitionName}"
                                 Watermark="分区名，如 boot"
                                 Height="34" />
                        <TextBox Grid.Column="1" Text="{Binding PartitionImagePath}"
                                 Watermark="镜像文件路径"
                                 Height="34" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Button Variant="Secondary" Click="OnPickPartitionImage">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                                <TextBlock Text="选择镜像" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button Variant="Primary" Command="{Binding FlashPartitionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Upload" Size="14" />
                                <TextBlock Text="刷入" />
                            </StackPanel>
                        </arc:Button>
                    </StackPanel>
                </StackPanel>
            </arc:Card>

            <!-- ============ 9008 ============ -->
            <arc:Card Title="9008 线刷 / 发送引导"
                      Description="线刷包必须是高通原厂格式（含 rawprogram*.xml）。端口在有设备进入 9008 时会自动填入。">
                <StackPanel Spacing="10" Margin="0,8,0,0">

                    <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding EdlPort}"
                                 Watermark="端口号，如 3"
                                 Height="34" />
                        <TextBox Grid.Column="1" Text="{Binding PackageDirectory}"
                                 Watermark="线刷包目录"
                                 Height="34" />
                        <arc:Button Grid.Column="2" Variant="Secondary" Click="OnPickPackageDirectory">
                            <TextBlock Text="浏览" />
                        </arc:Button>
                    </Grid>

                    <arc:Button Variant="Primary" HorizontalAlignment="Left"
                                Command="{Binding FlashFullPackageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="HardDriveDownload" Size="14" />
                            <TextBlock Text="线刷完整包" />
                        </StackPanel>
                    </arc:Button>

                    <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding ProgrammerPath}"
                                 Watermark="Firehose 引导文件（prog_firehose_ddr.elf）"
                                 Height="34" />
                        <arc:Button Grid.Column="1" Variant="Secondary" Click="OnPickProgrammer">
                            <TextBlock Text="浏览" />
                        </arc:Button>
                    </Grid>

                    <arc:Button Variant="Secondary" HorizontalAlignment="Left"
                                Command="{Binding SendFirehoseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Cable" Size="14" />
                            <TextBlock Text="发送引导（不刷机）" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </arc:Card>

            <!-- ============ 当前任务 + 日志 ============ -->
            <arc:Card Title="当前任务">
                <StackPanel Spacing="10" Margin="0,8,0,0">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding TaskTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <arc:Button Grid.Column="1" Variant="Text"
                                    Command="{Binding CancelCommand}"
                                    IsVisible="{Binding IsBusy}">
                            <TextBlock Text="取消" />
                        </arc:Button>
                    </Grid>

                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding TaskPercent}"
                                 IsIndeterminate="{Binding TaskIndeterminate}"
                                 Height="6" />

                    <TextBlock Text="{Binding TaskMessage}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               TextWrapping="Wrap" />

                    <Border MaxHeight="220"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            CornerRadius="6"
                            Padding="10"
                            IsVisible="{Binding IsBusy}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas,monospace"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </arc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
