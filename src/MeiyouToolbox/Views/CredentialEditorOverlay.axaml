<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.CredentialEditorOverlay"
             x:DataType="vm:FlashViewModel"
             IsVisible="{Binding IsCredentialEditorOpen}">

    <!--
        解锁资料子窗口。
        参考实现是把解锁码/授权码存成 res\%product%\bak\blunlockcode.txt
        与 edlauthcode.txt，解锁时现读。这里改成一个窗口录入，
        落盘到 profiles\<product>\，切机型时自动回填。
    -->
    <Grid Background="#88000000">
        <Border Width="520"
                CornerRadius="12"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderThickness="1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BoxShadow="0 12 40 0 #40000000">

            <StackPanel Spacing="12">

                <!-- 标题 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="解锁资料"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Text="{Binding SelectedProfile.DisplayName, FallbackValue='未选择机型'}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <arc:Button Grid.Column="1" Variant="Ghost"
                                Command="{Binding CloseCredentialEditorCommand}">
                        <lucide:LucideIcon Kind="X" Size="15" />
                    </arc:Button>
                </Grid>

                <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                <TextBlock Text="{Binding ImportCodesHint}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextWrapping="Wrap" MaxLines="3" />

                <!-- 解锁码 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="解锁码（512 字符）"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <arc:Input IsLabelVisible="False" Grid.Column="0"
                                   Placeholder="粘贴 512 字符解锁码"
                                   Text="{Binding UnlockCodeInput}"
                                   Height="34"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                        <arc:Button Grid.Column="1" Variant="Secondary"
                                    Command="{Binding SaveUnlockCodeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <lucide:LucideIcon Kind="Save" Size="12" />
                                <TextBlock Text="保存" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                            </StackPanel>
                        </arc:Button>
                    </Grid>
                </StackPanel>

                <!-- 授权码 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="授权码（512 字符，9008 认证用）"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <arc:Input IsLabelVisible="False" Grid.Column="0"
                                   Placeholder="粘贴 512 字符授权码"
                                   Text="{Binding AuthCodeInput}"
                                   Height="34"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                        <arc:Button Grid.Column="1" Variant="Secondary"
                                    Command="{Binding SaveAuthCodeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <lucide:LucideIcon Kind="Save" Size="12" />
                                <TextBlock Text="保存" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                            </StackPanel>
                        </arc:Button>
                    </Grid>
                </StackPanel>

                <!-- mzkv -->
                <StackPanel Spacing="4">
                    <TextBlock Text="解锁版 mzkv 镜像（仅 mzkv 机型需要）"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <arc:Button Grid.Column="0" Variant="Secondary"
                                    Click="OnPickMzkv"
                                    ToolTip.Tip="选择解锁用 mzkv 镜像">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <lucide:LucideIcon Kind="FolderOpen" Size="12" />
                                <TextBlock Text="选择 mzkv" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                            </StackPanel>
                        </arc:Button>
                        <TextBlock Grid.Column="1" Text="{Binding CredentialStatus}"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                <!-- 底部：说明 + 清空 + 完成 -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="资料保存在程序目录的 profiles\ 下，下次选同一机型时自动载入。"
                               VerticalAlignment="Center"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextWrapping="Wrap" MaxLines="2" />
                    <arc:Button Grid.Column="1" Variant="Ghost"
                                Command="{Binding ClearCredentialsCommand}">
                        <TextBlock Text="清空本机资料" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                    </arc:Button>
                    <arc:Button Grid.Column="2" Variant="Primary"
                                Command="{Binding CloseCredentialEditorCommand}">
                        <TextBlock Text="完成" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                    </arc:Button>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
