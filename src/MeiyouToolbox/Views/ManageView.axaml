<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:models="using:MeiyouToolbox.Models"
             xmlns:sys="using:System"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.ManageView"
             x:DataType="vm:ManageViewModel">

    <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="10">

        <!-- 标题 + 连接状态 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="2">
                <TextBlock Text="管理"
                           FontSize="{arc:ArcDesignTokenResource TypeXL}"
                           FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock Text="槽位切换、分区表读取、擦除与格式化。直接改动设备结构，动手前先备份。"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border Padding="9,4" CornerRadius="6"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Usb" Size="13" />
                        <TextBlock Text="{Binding ConnectionText}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    </StackPanel>
                </Border>
                <arc:Button Variant="Secondary" Command="{Binding RefreshConnectionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="RefreshCw" Size="13" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>
        </Grid>

        <!-- 双列主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">

            <!-- 左列 -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="10">

                    <!-- 机型与端口 -->
                    <arc:Card Title="机型与端口"
                              Description="机型决定存储类型与分区布局；端口留空自动取第一个。">
                        <StackPanel Spacing="8" Margin="0,6,0,0">

                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="选择机型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceProfile">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Cpu}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <arc:Input IsLabelVisible="False" Grid.Column="0"
                                           Text="{Binding EdlPort}"
                                           Placeholder="9008 端口（留空自动检测）"
                                           Height="32" />
                                <arc:Button Grid.Column="1" Variant="Secondary"
                                            Command="{Binding ReadPartitionsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="HardDrive" Size="13" />
                                        <TextBlock Text="读取分区表" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>
                        </StackPanel>
                    </arc:Card>

                    <!-- 槽位 -->
                    <arc:Card Title="槽位"
                              Description="A/B 机型有两个可切换的系统槽位，用于回退失败的更新。">
                        <StackPanel Spacing="8" Margin="0,6,0,0">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="当前"
                                           VerticalAlignment="Center"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <Border Grid.Column="1" Padding="8,4" CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="Layers" Size="13" />
                                        <TextBlock Text="{Binding SlotDisplay}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    </StackPanel>
                                </Border>
                                <arc:Button Grid.Column="2" Variant="Text"
                                            Command="{Binding ReadSlotCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="ScanLine" Size="13" />
                                        <TextBlock Text="重新检测" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding SlotChoices}"
                                          SelectedItem="{Binding SelectedSlotTarget}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="选择目标槽位">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SlotChoice">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <arc:Button Grid.Column="1" Variant="Primary"
                                            Command="{Binding SwitchSlotCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="ArrowLeftRight" Size="13" />
                                        <TextBlock Text="切换" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>

                            <Border Padding="9,7" CornerRadius="6"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    IsVisible="{Binding HasSlotWarning}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lucide:LucideIcon Kind="TriangleAlert" Size="13" />
                                    <TextBlock Text="{Binding SlotWarning}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="注意：meizu20inf 的槽位与 fastbootd 有问题，不在本工具保护范围内。"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </arc:Card>

                    <!-- 当前任务 -->
                    <arc:Card Title="当前任务">
                        <StackPanel Spacing="8" Margin="0,6,0,0">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding TaskTitle}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                <arc:Button Grid.Column="1" Variant="Text"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding IsBusy}">
                                    <TextBlock Text="取消" />
                                </arc:Button>
                            </Grid>

                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding TaskPercent}"
                                         IsIndeterminate="{Binding TaskIndeterminate}"
                                         Height="5" />

                            <TextBlock Text="{Binding TaskMessage}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       TextWrapping="Wrap" />

                            <Border MaxHeight="130"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    CornerRadius="6"
                                    Padding="8"
                                    IsVisible="{Binding IsBusy}">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding LogLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas,monospace"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </arc:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- 右列 -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="10">

                    <!-- 分区表 -->
                    <arc:Card Title="分区表"
                              Description="9008 模式读取前需先发送引导文件。">
                        <StackPanel Spacing="8" Margin="0,6,0,0">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PartitionStatus}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <arc:Button Grid.Column="1" Variant="Secondary"
                                            Command="{Binding ReadPartitionsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="ListChecks" Size="13" />
                                        <TextBlock Text="读取" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>

                            <Border BorderThickness="1"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    CornerRadius="6"
                                    MaxHeight="230"
                                    IsVisible="{Binding HasPartitions}">
                                <ScrollViewer>
                                    <StackPanel>
                                        <!-- 表头 -->
                                        <Grid ColumnDefinitions="46,*,92,86,74"
                                              Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                              Height="28">
                                            <TextBlock Grid.Column="0" Text="LUN" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="分区" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Grid.Column="2" Text="起始扇区" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Grid.Column="3" Text="扇区数" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Grid.Column="4" Text="大小" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        </Grid>

                                        <ListBox ItemsSource="{Binding Partitions}"
                                                 SelectedItem="{Binding SelectedPartition}"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ManagePartitionRow">
                                                    <Grid ColumnDefinitions="46,*,92,86,74" Height="26">
                                                        <TextBlock Grid.Column="0" Text="{Binding Lun}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding StartSector}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding SectorCount}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </arc:Card>

                    <!-- 擦除与格式化 -->
                    <arc:Card Title="擦除与格式化"
                              Description="擦除需 9008；格式化需 Fastboot。">
                        <StackPanel Spacing="8" Margin="0,6,0,0">

                            <Border Padding="9,7" CornerRadius="6"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lucide:LucideIcon Kind="Package" Size="13" />
                                    <TextBlock Text="{Binding SelectedPartitionText}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ComboBox ItemsSource="{Binding FileSystems}"
                                      SelectedItem="{Binding SelectedFileSystem}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="选择文件系统">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileSystemOption">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{Binding SelectedFileSystemDescription}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />

                            <!-- 危险操作确认 -->
                            <Border Padding="9,7" CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Kind="ShieldAlert" Size="13" />
                                        <TextBlock Text="危险操作，不可撤销"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    </StackPanel>

                                    <TextBlock Text="永久清除所选分区的内容。system / boot / persist 这类分区已在代码里硬拒绝，避免毁掉设备。"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               TextWrapping="Wrap" />

                                    <CheckBox Content="我已确认这是目标分区，并已备份重要数据"
                                              FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                              IsChecked="{Binding DangerConfirmed}" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <arc:Button Grid.Column="0" Variant="Danger"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ErasePartitionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="Eraser" Size="13" />
                                        <TextBlock Text="擦除分区" />
                                    </StackPanel>
                                </arc:Button>
                                <arc:Button Grid.Column="1" Variant="Danger"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding FormatPartitionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <lucide:LucideIcon Kind="Paintbrush" Size="13" />
                                        <TextBlock Text="格式化" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>

                            <TextBlock Text="格式化由主机端 mke2fs / make_f2fs 生成镜像再整块刷入，因此需要 Fastboot 模式。"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </arc:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
