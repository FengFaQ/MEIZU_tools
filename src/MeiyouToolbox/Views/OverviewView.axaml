<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:sys="using:System"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <!--
        两栏布局：
          左栏（通栏）  → 手机状态 + 电脑状态 + 快捷打开，都收在一张卡里，把原来的空行填满
          右栏（固定宽）→ 运行日志（软件运行日志 + 刷写/备份等操作记录），实时追加
        颜色全部走 Arc Design Token（{arc:ArcDesignTokenResource ...}），
        不自己定义画刷，避免与 Arc 的亮/暗主题冲突导致白字白底。
    -->
    <Grid Margin="16" ColumnDefinitions="*,360" ColumnSpacing="16">

        <!-- ======== 左栏：手机状态 + 电脑状态 + 快捷打开 ======== -->
        <arc:Card Grid.Column="0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- 第一行：连接状态 + 刷新 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="手机状态"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding IsConnected, Converter={StaticResource StatusDotConverter}}" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                           FontWeight="SemiBold"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            </StackPanel>
                        </StackPanel>

                        <arc:Button Grid.Column="1" Variant="Secondary"
                                    VerticalAlignment="Top"
                                    Command="{Binding RefreshDeviceCommand}"
                                    IsEnabled="{Binding !IsProbing}"
                                    ToolTip.Tip="重新探测设备">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </arc:Button>
                    </Grid>

                    <!-- 第二行：连接途径（未连接时不显示） -->
                    <Border IsVisible="{Binding HasConnectionPath}"
                            CornerRadius="8" Padding="12,8"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="连接途径"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionPathText}"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                    <!-- 第三部分：14 项设备信息 -->
                    <ItemsControl ItemsSource="{Binding DeviceFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceFieldRow">
                                <Grid ColumnDefinitions="90,*" Margin="0,0,16,12">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                    <!-- 第四部分：电脑状态 + 当前任务（原来在右栏，现在并入这里填空行） -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="电脑状态"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TaskTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   HorizontalAlignment="Right" />

                        <Grid Grid.Row="1" Grid.ColumnSpan="2"
                              ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <lucide:LucideIcon Grid.Column="0" Kind="Zap" Size="14"
                                               VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding BatteryText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       VerticalAlignment="Center" />

                            <ProgressBar Grid.Column="2" Width="120"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding CurrentTask.Percent}"
                                         IsIndeterminate="{Binding CurrentTask.IsIndeterminate}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding TaskPercentText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                    <!-- 第五部分：快捷打开（原来在右栏下方） -->
                    <TextBlock Text="快捷打开"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                    <UniformGrid Columns="4" Rows="1">
                        <arc:Button Classes="quick" Variant="Secondary" Margin="0,0,6,0"
                                    Command="{Binding OpenComputerManagementCommand}"
                                    ToolTip.Tip="C:\Windows\System32\mmc.exe">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Kind="PanelLeft" Size="15" />
                                <TextBlock Text="设备管理" />
                            </StackPanel>
                        </arc:Button>

                        <arc:Button Classes="quick" Variant="Secondary" Margin="0,0,6,0"
                                    Command="{Binding OpenTerminalCommand}"
                                    ToolTip.Tip="在工具目录打开 CMD（可直接用 adb / fastboot）">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Kind="Terminal" Size="15" />
                                <TextBlock Text="终端" />
                            </StackPanel>
                        </arc:Button>

                        <arc:Button Classes="quick" Variant="Secondary" Margin="0,0,6,0"
                                    Command="{Binding OpenTaskManagerCommand}"
                                    ToolTip.Tip="C:\Windows\System32\Taskmgr.exe">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Kind="Activity" Size="15" />
                                <TextBlock Text="任务管理器" />
                            </StackPanel>
                        </arc:Button>

                        <arc:Button Classes="quick" Variant="Secondary"
                                    Command="{Binding OpenAppDirectoryCommand}"
                                    ToolTip.Tip="在资源管理器中打开程序目录">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Kind="FolderOpen" Size="15" />
                                <TextBlock Text="目录管理" />
                            </StackPanel>
                        </arc:Button>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </arc:Card>

        <!-- ======== 右栏：运行日志 ======== -->
        <arc:Card Grid.Column="1" Padding="16" Title="运行日志"
                  Description="软件运行与刷写、备份操作的实时记录，完整内容见 logs\ 目录。">
            <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,6,0,0">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="{Binding AppVersion, StringFormat='魅友工具箱 {0}'}"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center" />

                    <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                Command="{Binding ClearLogCommand}"
                                ToolTip.Tip="只清空界面显示，磁盘上的日志不受影响">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Eraser" Size="12" />
                            <TextBlock Text="清空" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                        </StackPanel>
                    </arc:Button>
                </Grid>

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        CornerRadius="6"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        Padding="8">
                    <ScrollViewer x:Name="LogScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas,monospace"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </arc:Card>
    </Grid>
</UserControl>
