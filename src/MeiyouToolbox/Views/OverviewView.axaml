<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <!--
        坐标系约定（原点 = 主窗口中心，X 轴向右为正、Y 轴向上为正）：
          第一/四象限（贯穿 X 轴）= 左半通栏  → 手机状态
          第二象限（右上）                  → 电脑状态 + 当前任务
          第三象限（右下）                  → 快捷打开
        颜色全部走 Arc Design Token（{arc:ArcDesignTokenResource ...}），
        不自己定义画刷，避免与 Arc 的亮/暗主题冲突导致白字白底。
    -->
    <Grid Margin="16" ColumnDefinitions="*,340" RowDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="16">

        <!-- ======== 第一、四象限：手机状态（左侧通栏） ======== -->
        <arc:Card Grid.Column="0" Grid.RowSpan="2" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- 第一行：连接状态 + 刷新 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="手机状态"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding IsConnected, Converter={StaticResource StatusDotConverter}}" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                           FontWeight="SemiBold"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            </StackPanel>
                        </StackPanel>

                        <arc:Button Grid.Column="1" Variant="Secondary"
                                    VerticalAlignment="Top"
                                    Command="{Binding RefreshDeviceCommand}"
                                    IsEnabled="{Binding !IsProbing}"
                                    ToolTip.Tip="重新探测设备">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </arc:Button>
                    </Grid>

                    <!-- 第二行：连接途径（未连接时不显示） -->
                    <Border IsVisible="{Binding HasConnectionPath}"
                            CornerRadius="8" Padding="12,8"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="连接途径"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionPathText}"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                    <!-- 第三部分：14 项设备信息 -->
                    <ItemsControl ItemsSource="{Binding DeviceFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceFieldRow">
                                <Grid ColumnDefinitions="90,*" Margin="0,0,16,12">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </arc:Card>

        <!-- ======== 第二象限：电脑状态 + 当前任务 ======== -->
        <arc:Card Grid.Column="1" Grid.Row="0" Padding="20" VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <TextBlock Text="电脑状态"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                    <lucide:LucideIcon Grid.Row="0" Grid.Column="0" Kind="Zap" Size="15"
                                      VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BatteryText}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                               VerticalAlignment="Center" />

                    <lucide:LucideIcon Grid.Row="1" Grid.Column="0" Kind="Smartphone" Size="15"
                                      VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding AppVersion, StringFormat='魅友工具箱 {0}'}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                               VerticalAlignment="Center" />
                </Grid>

                <Separator Background="{arc:ArcDesignTokenResource BorderSubtle}" Height="1" />

                <TextBlock Text="当前任务"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                <TextBlock Text="{Binding TaskTitle}"
                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ProgressBar Grid.Column="0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding CurrentTask.Percent}"
                                 IsIndeterminate="{Binding CurrentTask.IsIndeterminate}"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TaskPercentText}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </arc:Card>

        <!-- ======== 第三象限：快捷打开 ======== -->
        <arc:Card Grid.Column="1" Grid.Row="1" Padding="20" VerticalAlignment="Bottom">
            <StackPanel Spacing="12">
                <TextBlock Text="快捷打开"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                <UniformGrid Columns="2" Rows="2">
                    <arc:Button Classes="quick" Variant="Secondary"
                                Command="{Binding OpenComputerManagementCommand}"
                                ToolTip.Tip="C:\Windows\System32\mmc.exe">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="PanelLeft" Size="15" />
                            <TextBlock Text="设备管理" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="quick" Variant="Secondary"
                                Command="{Binding OpenTerminalCommand}"
                                ToolTip.Tip="在工具目录打开 CMD（可直接用 adb / fastboot）">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="Terminal" Size="15" />
                            <TextBlock Text="终端" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="quick" Variant="Secondary"
                                Command="{Binding OpenTaskManagerCommand}"
                                ToolTip.Tip="C:\Windows\System32\Taskmgr.exe">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="Activity" Size="15" />
                            <TextBlock Text="任务管理器" />
                        </StackPanel>
                    </arc:Button>

                    <arc:Button Classes="quick" Variant="Secondary"
                                Command="{Binding OpenAppDirectoryCommand}"
                                ToolTip.Tip="在资源管理器中打开程序目录">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:LucideIcon Kind="FolderOpen" Size="15" />
                            <TextBlock Text="目录管理" />
                        </StackPanel>
                    </arc:Button>
                </UniformGrid>
            </StackPanel>
        </arc:Card>
    </Grid>
</UserControl>
