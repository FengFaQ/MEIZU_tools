<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:MeiyouToolbox.ViewModels"
             x:Class="MeiyouToolbox.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <!--
        注意：TKCode.Arc 的 Lucide 图标由源生成器按"字面量 Kind"编译进程序。
        用绑定传 Kind 时生成器无法判断需要哪些图标（ARCL002），图标会画不出来。
        因此这里按 IconKind 做字面量分支，同时 csproj 里显式声明这些图标。

        颜色全部走 Arc Design Token，不自定义画刷。
    -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <Panel HorizontalAlignment="Center">
            <lucide:LucideIcon Kind="Zap" Size="40" IsVisible="{Binding IsFlashIcon}" />
            <lucide:LucideIcon Kind="HardDriveDownload" Size="40" IsVisible="{Binding IsBackupIcon}" />
            <lucide:LucideIcon Kind="Wrench" Size="40" IsVisible="{Binding IsManageIcon}" />
            <lucide:LucideIcon Kind="Settings" Size="40" IsVisible="{Binding IsSettingsIcon}" />
        </Panel>

        <TextBlock Text="{Binding Title}"
                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                   FontWeight="SemiBold"
                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding Description}"
                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="420" />
    </StackPanel>
</UserControl>
